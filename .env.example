# Optional. A deployment-wide key so visitors don't need their own. Without it,
# people can paste their own key in the demo panel (sent per call, never stored
# server-side) or keep the rules brain, which needs no key at all.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6
OPENAI_MODEL=gpt-4.1-mini
GEMINI_MODEL=gemini-2.5-flash

# Optional. Serve the two halves from separate origins and set this to the
# other one; tools then register with exposedTo and are discovered with
# fromOrigins, so the isolation is browser-enforced.
NEXT_PUBLIC_PARTNER_ORIGIN=

# Where Bramble Bank runs. Defaults to http://localhost:3001 in development.
# In production both origins must be https for exposedTo to accept them.
NEXT_PUBLIC_BANK_ORIGIN=

# For the bank process (node bank/server.mjs): which origin may discover its
# tools. Defaults to http://localhost:3000.
BANK_PARTNER_ORIGIN=
BANK_PORT=3001

# Demo-only. Skips half-key checks so ?role= in the address is trusted.
# Leave unset: with it, anyone can act as either party.
SLATE_OPEN_ROOMS=
