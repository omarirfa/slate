{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "bramble-bank",
  "main": "worker.mjs",
  "compatibility_date": "2025-06-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },
  "durable_objects": {
    "bindings": [{ "name": "LEDGER", "class_name": "BankLedger" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["BankLedger"] }],
  "vars": {
    // The only origin the bank exposes its tools to. Set to the slate's URL
    // after the first deploy (wrangler deploy --var or the dashboard).
    "BANK_PARTNER_ORIGIN": "http://localhost:3000"
  },
  "observability": { "enabled": true }
}
