{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "slate",
  // The custom entry serves the Next.js app and exports the room Durable Object.
  "main": "cf/worker.ts",
  "compatibility_date": "2025-06-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "slate"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "ROOM",
        "class_name": "SlateRoom"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      // SQLite-backed: the only kind available on the Workers Free plan.
      "new_sqlite_classes": ["SlateRoom"]
    }
  ],
  "vars": {
    // Leave unset in production. "1" trusts ?role= in the address (demo only).
    "SLATE_OPEN_ROOMS": ""
  },
  "observability": {
    "enabled": true
  }
}
